{
  "name": "break-the-screen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BREAK THE SCREEN — reality has no boundaries. Head-tracked off-axis 3D window, hand-gesture physics, a glass screen you can shatter from the inside.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
