    "@fontsource-variable/geist-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
