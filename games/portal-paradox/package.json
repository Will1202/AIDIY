{
  "name": "portal-paradox",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PORTAL PARADOX — Reality is broken. A browser-based real-time portal engine with physics, recursion, gravity shift and time rewind.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
